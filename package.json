{
  "name": "@rathnasgala2/theme-tooling",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Shared dev/test/SBOM/release tooling for the five @rathnasgala2/theme-* packages (theme-default, theme-minimal, theme-amaze, theme-flashy, theme-zebra). Not yet published (OWNER-DECISION); consumed today via the GALA_THEME_TOOLING_DIR override documented in README.md.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rathnasgala2/theme-tooling.git"
  },
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "format": "prettier --write --config .prettierrc.json '*.md' 'bin/*.mjs' 'scripts/*.mjs' 'test/**/*.mjs' eslint.config.js",
    "format:check": "prettier --check --config .prettierrc.json '*.md' 'bin/*.mjs' 'scripts/*.mjs' 'test/**/*.mjs' eslint.config.js",
    "lint": "eslint --config eslint.config.js .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "duplication": "jscpd --config .jscpd.json",
    "sbom:generate": "node scripts/generate-own-sbom.mjs",
    "sbom:check": "node scripts/check-own-sbom-current.mjs",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm test && npm run duplication && npm run sbom:check && npm run audit"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@rathnasgala2/schemas": "2.11.0",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jscpd": "5.2.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.6"
  }
}
